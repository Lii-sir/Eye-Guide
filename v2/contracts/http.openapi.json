{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AUTH_REQUIRED",
              "AUTH_EXPIRED",
              "FORBIDDEN",
              "DEVICE_REVOKED",
              "NOT_FOUND",
              "SESSION_CLOSED",
              "CONNECTION_CONFLICT",
              "UNSUPPORTED_VERSION",
              "BAD_MESSAGE",
              "BAD_FRAME",
              "FRAME_TOO_LARGE",
              "BUSY",
              "REVISION_CONFLICT",
              "IDEMPOTENCY_CONFLICT",
              "MODEL_UNAVAILABLE",
              "INTERNAL_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "CreateSession": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "protocol_version": {
            "const": "2.0",
            "title": "Protocol Version",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "protocol_version"
        ],
        "title": "CreateSession",
        "type": "object"
      },
      "DeviceView": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "state": {
            "enum": [
              "active",
              "revoked"
            ],
            "title": "State",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "user_id",
          "state"
        ],
        "title": "DeviceView",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "RegisterDevice": {
        "additionalProperties": false,
        "properties": {
          "app_version": {
            "maxLength": 32,
            "minLength": 1,
            "title": "App Version",
            "type": "string"
          },
          "installation_id": {
            "format": "uuid",
            "title": "Installation Id",
            "type": "string"
          },
          "label": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "platform": {
            "const": "android",
            "default": "android",
            "title": "Platform",
            "type": "string"
          }
        },
        "required": [
          "installation_id",
          "label",
          "app_version"
        ],
        "title": "RegisterDevice",
        "type": "object"
      },
      "SessionPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionView"
            },
            "maxItems": 100,
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "SessionPage",
        "type": "object"
      },
      "SessionSummary": {
        "additionalProperties": false,
        "properties": {
          "frames_dropped": {
            "minimum": 0,
            "title": "Frames Dropped",
            "type": "integer"
          },
          "frames_processed": {
            "minimum": 0,
            "title": "Frames Processed",
            "type": "integer"
          },
          "frames_received": {
            "minimum": 0,
            "title": "Frames Received",
            "type": "integer"
          }
        },
        "required": [
          "frames_received",
          "frames_processed",
          "frames_dropped"
        ],
        "title": "SessionSummary",
        "type": "object"
      },
      "SessionView": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "end_reason": {
            "anyOf": [
              {
                "enum": [
                  "user_stop",
                  "app_background",
                  "screen_locked",
                  "client_error",
                  "connection_lost",
                  "auth_expired",
                  "device_revoked",
                  "server_shutdown",
                  "process_restart",
                  "start_timeout"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Reason"
          },
          "ended_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ended At"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "state": {
            "enum": [
              "created",
              "active",
              "stopping",
              "ended",
              "interrupted"
            ],
            "title": "State",
            "type": "string"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SessionSummary"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "session_id",
          "device_id",
          "state",
          "started_at"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "SettingsUpdate": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "values": {
            "$ref": "#/components/schemas/SettingsValues"
          }
        },
        "required": [
          "expected_revision",
          "values"
        ],
        "title": "SettingsUpdate",
        "type": "object"
      },
      "SettingsValues": {
        "additionalProperties": false,
        "properties": {
          "reminder_detail": {
            "enum": [
              "normal",
              "detailed"
            ],
            "title": "Reminder Detail",
            "type": "string"
          },
          "speech_enabled": {
            "title": "Speech Enabled",
            "type": "boolean"
          },
          "speech_rate": {
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speech Rate",
            "type": "number"
          }
        },
        "required": [
          "speech_enabled",
          "speech_rate",
          "reminder_detail"
        ],
        "title": "SettingsValues",
        "type": "object"
      },
      "SettingsView": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "minimum": 0,
            "title": "Revision",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "values": {
            "$ref": "#/components/schemas/SettingsValues"
          }
        },
        "required": [
          "revision",
          "values"
        ],
        "title": "SettingsView",
        "type": "object"
      },
      "StopSession": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": [
              "user_stop",
              "app_background",
              "screen_locked",
              "client_error"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "StopSession",
        "type": "object"
      },
      "UserView": {
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "active",
              "disabled"
            ],
            "title": "State",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "state"
        ],
        "title": "UserView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "accessToken": {
        "description": "Validated OIDC access token; never an ID token or a URL query parameter.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
